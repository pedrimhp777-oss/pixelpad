{
  "name": "pixelpad",
  "version": "0.12.0",
  "private": true,
  "description": "Use o celular como controle (gamepad Xbox virtual) e trackpad do PC pela rede local. Sem cabo, sem nuvem, ~1ms de latencia.",
  "type": "module",
  "main": "src/server.mjs",
  "scripts": {
    "start": "node src/server.mjs",
    "build": "node tools/build.mjs",
    "build:apk": "node tools/build-apk.mjs",
    "build:all": "node tools/build-apk.mjs && node tools/build.mjs"
  },
  "keywords": [
    "gamepad",
    "controller",
    "trackpad",
    "vigem",
    "xinput",
    "lan",
    "pwa"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "koffi": "^3.3.8",
    "node-forge": "^1.4.4",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.23.0"
  }
}
